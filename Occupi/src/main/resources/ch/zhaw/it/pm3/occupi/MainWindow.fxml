<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>


<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<BorderPane prefHeight="600.0" prefWidth="1100.0" stylesheets="@/css/styles.css"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ch.zhaw.it.pm3.occupi.controllers.MainWindowController">
    <top>
        <VBox>
            <children>
                <!-- Header -->
                <VBox styleClass="header">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="label-title" text="Occupi"/>
                                        <Label styleClass="label-italic" text="ZHAW Raumübersicht in Echtzeit"/>
                                    </children>
                                </VBox>
                                <Label fx:id="notificationLabel" managed="false" styleClass="notification-badge"
                                       text="Neue Daten verfügbar" visible="false"/>
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="8.0" left="16.0" right="16.0" top="12.0"/>
                    </padding>
                </VBox>

                <!-- Search bar -->
                <VBox styleClass="search-bar" BorderPane.alignment="CENTER_LEFT">
                    <children>
                        <!-- Search Row -->
                        <HBox spacing="12.0">
                            <children>
                                <TextField fx:id="tfRoom" onKeyPressed="#searchOnEnterPress" promptText="Raum suchen" styleClass="search-input"
                                           HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnToggleFilters" onAction="#toggleFilters" styleClass="filter-toggle"
                                        text="Filter anzeigen"/>
                            </children>
                            <padding>
                                <Insets bottom="8.0" left="0.0" right="0.0" top="0.0"/>
                            </padding>
                        </HBox>

                        <!-- Filter Section: moved here so it pushes center down when visible -->
                        <VBox fx:id="filterSection" managed="false" styleClass="filter-overlay" visible="false">
                            <children>
                                <GridPane hgap="16.0" vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>

                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <padding>
                                        <Insets left="16.0" right="16.0" top="8.0"/>
                                    </padding>

                                    <!-- Row 0: Room number, Date -->
                                    <children>
                                        <!-- Row 1: Location, Building -->
                                        <VBox prefWidth="500.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="filter-label" text="STANDORT"/>
                                            <ComboBox fx:id="cbLocation" onAction="#filterBuildingsByLocation"
                                                      prefWidth="500.0"
                                                      styleClass="filter-select"/>
                                        </VBox>
                                        <VBox prefWidth="500.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label styleClass="filter-label" text="GEBÄUDE"/>
                                            <ComboBox fx:id="cbBuilding" onAction="#filterFloorsByBuilding"
                                                      prefWidth="500.0"
                                                      styleClass="filter-select"/>
                                        </VBox>
                                        <!-- Row 4: Room type, Floor -->
                                        <VBox prefWidth="500.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label styleClass="filter-label" text="RAUMTYP"/>
                                            <ComboBox fx:id="cbRoomType" prefWidth="500.0"
                                                      styleClass="filter-select"/>
                                        </VBox>
                                        <VBox prefWidth="500.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label styleClass="filter-label" text="STOCKWERK"/>
                                            <ComboBox fx:id="cbFloor" prefWidth="500.0"
                                                      styleClass="filter-select" GridPane.columnIndex="3"
                                                      GridPane.rowIndex="2"/>
                                        </VBox>
                                        <VBox prefWidth="500.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <!-- Row 5: Infrastructure, Person count -->
                                            <Label styleClass="filter-label" text="INFRASTRUKTUR"/>
                                            <ComboBox fx:id="cbInfrastructure" prefWidth="500.0"
                                                      styleClass="filter-select"/>
                                        </VBox>
                                        <VBox prefWidth="500.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <Label styleClass="filter-label" text="MIND. PERSONENANZAHL"/>
                                            <ComboBox fx:id="cbPersonCount" prefWidth="500.0"
                                                      styleClass="filter-select"/>
                                        </VBox>
                                    </children>
                                    <rowConstraints>
                                        <RowConstraints/>
                                        <RowConstraints/>
                                        <RowConstraints/>
                                        <RowConstraints/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0"/>
                                    </rowConstraints>
                                </GridPane>
                                <HBox alignment="CENTER_RIGHT" fillHeight="false" spacing="8.0">
                                    <children>
                                        <Button onAction="#handleReset" styleClass="btn-secondary"
                                                text="Reset"/>
                                        <Button defaultButton="true" onAction="#searchRooms"
                                                styleClass="btn-primary" text="Search"/>
                                    </children>
                                    <padding>
                                        <Insets bottom="16.0" left="16.0" right="16.0"/>
                                    </padding>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="searchResultPane" fitToHeight="true" fitToWidth="true" BorderPane.alignment="CENTER"/>
    </center>

</BorderPane>
